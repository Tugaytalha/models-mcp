# Kopyalayıp .env yapın (python scripts/setup.py local bunu otomatik yapar). .env git'e girmez.

# Hızlı deneme (SQLite). Gerçek kullanım için Postgres:
#   postgresql+psycopg://catalog:catalog@localhost:5432/catalog
CATALOG_DATABASE_URL=sqlite:///./dev.db

# Açılışta şemayı otomatik günceller (Postgres'te advisory lock ile çok replica güvenli). Kapatmak için false.
CATALOG_AUTO_MIGRATE=true

# Sunucunun dışarıdan görünen host adı (virgülle). Üretimde mutlaka doldurun; "*" = DNS-rebinding koruması kapalı.
CATALOG_ALLOWED_HOSTS=*

# MCP sunucusunun ağ olarak ulaşabildiği lokasyon/ortamlar. Boşsa canlı test yoktur, kullanıcıya komut verilir.
CATALOG_PROBE_REACHABLE_LOCATIONS=
CATALOG_PROBE_REACHABLE_ENVIRONMENTS=
CATALOG_PROBE_TIMEOUT_SECONDS=5
